{
    "version": 1,
    "builds": [
      {
        "src": "./index.js",
        "use": "@vercel/node"
      },
      {
        "src": "public/api/uploads/**",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/api/uploads/(.*)",
        "dest": "/public/api/uploads/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/"
      }
    ]
  }
  